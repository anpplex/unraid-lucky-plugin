if ($_SERVER['REQUEST_METHOD'] === 'POST') {
  $action = $_POST['action'] ?? '';

  if ($action === 'save') {
    $config['CONFIG_DIR'] = trim($_POST['CONFIG_DIR'] ?? $config['CONFIG_DIR']);
    $config['WEB_PORT'] = preg_replace('/[^0-9]/', '', $_POST['WEB_PORT'] ?? $config['WEB_PORT']);
    $config['AUTOSTART'] = lucky_normalize_autostart($_POST['AUTOSTART'] ?? $config['AUTOSTART']);
    $config['UI_LANG'] = lucky_normalize_lang($_POST['UI_LANG'] ?? $config['UI_LANG']);
    $lang = $config['UI_LANG'];
    $config['EXTRA_ARGS'] = trim($_POST['EXTRA_ARGS'] ?? '');
    $interval = $_POST['UPDATE_INTERVAL'] ?? ($config['UPDATE_INTERVAL'] ?? 'off');
    $config['UPDATE_INTERVAL'] = in_array($interval, ['off', 'daily', 'weekly', 'monthly'], true) ? $interval : 'off';
    if ($config['WEB_PORT'] === '') {
      $config['WEB_PORT'] = '16601';
    }
    lucky_write_config($configFile, $config);
    lucky_apply_update_schedule($scheduleScript);
    $message = lucky_t('settings_saved');
  } elseif (in_array($action, ['start', 'stop', 'restart'], true)) {
    $message = lucky_run($action);
  } elseif ($action === 'logs') {
    $logs = lucky_run('logs');
  } elseif (in_array($action, ['check_update', 'install_update'], true)) {
    $updateOutput = lucky_update($updateScript, $action === 'install_update' ? 'install' : 'check');
  }
}

$status = lucky_status($statusScript);
$running = ($status['running'] ?? 'no') === 'yes';
$host = $_SERVER['HTTP_HOST'] ?? ($_SERVER['SERVER_NAME'] ?? 'tower');
