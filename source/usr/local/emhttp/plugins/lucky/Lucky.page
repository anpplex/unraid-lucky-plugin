$csrfToken = $var['csrf_token'] ?? '';

function lucky_parse_config($file) {
  $config = [];
  if (!is_file($file)) {
    return $config;
  }
  foreach (file($file, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
    if ($line === '' || $line[0] === '#') {
      continue;
    }
    if (strpos($line, '=') === false) {
      continue;
    }
    [$key, $value] = explode('=', $line, 2);
    $value = trim($value);
    if (strlen($value) >= 2 && $value[0] === '"' && substr($value, -1) === '"') {
      $value = stripcslashes(substr($value, 1, -1));
    }
    $config[$key] = $value;
  }
  return $config;
}

function lucky_write_config($file, $config) {
  $ordered = ['CONFIG_DIR', 'WEB_PORT', 'AUTOSTART', 'UI_LANG', 'EXTRA_ARGS', 'UPDATE_INTERVAL'];
  $lines = [];
  foreach ($ordered as $key) {
    $value = $config[$key] ?? '';
    $safe = addcslashes($value, "\\\"");
    $lines[] = $key . '="' . $safe . '"';
  }
  if (!is_dir(dirname($file))) {
    mkdir(dirname($file), 0755, true);
  }
  file_put_contents($file, implode("\n", $lines) . "\n");
}

function lucky_normalize_autostart($value) {
  if ($value === 'yes' || $value === 'array') {
    return 'array';
  }
  if ($value === 'boot') {
    return 'boot';
  }
  return 'no';
}

function lucky_normalize_lang($value) {
  return $value === 'en' ? 'en' : 'zh';
}

function lucky_t($key) {
  global $lang, $luckyText;
  if (isset($luckyText[$lang][$key])) {
    return $luckyText[$lang][$key];
  }
  return $luckyText['zh'][$key] ?? $key;
}

function lucky_apply_update_schedule($script) {
  if (!is_executable($script)) {
    return '';
  }
  return shell_exec(escapeshellcmd($script) . ' apply 2>&1') ?: '';
}

function lucky_run($action) {
  global $rc;
  $allowed = ['start', 'stop', 'restart', 'status', 'logs'];
  if (!in_array($action, $allowed, true)) {
    return 'Unknown action.';
  }
  return shell_exec(escapeshellcmd($rc) . ' ' . escapeshellarg($action) . ' 2>&1') ?: '';
}

function lucky_update($script, $action) {
  $allowed = ['check', 'install'];
  if (!in_array($action, $allowed, true)) {
    return 'Unknown update action.';
  }
  if (!is_executable($script)) {
    return 'Update script is not available.';
  }
  return shell_exec(escapeshellcmd($script) . ' ' . escapeshellarg($action) . ' 2>&1') ?: '';
}

function lucky_status($script) {
  $status = [];
  if (!is_executable($script)) {
    return $status;
  }
  $output = shell_exec(escapeshellcmd($script) . ' 2>/dev/null') ?: '';
  foreach (explode("\n", trim($output)) as $line) {
    if (strpos($line, '=') !== false) {
      [$key, $value] = explode('=', $line, 2);
      $status[$key] = $value;
    }
  }
  return $status;
}

function lucky_h($value) {
  return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
}

